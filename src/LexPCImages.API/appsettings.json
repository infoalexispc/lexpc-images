{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Optimizer": {
    "QueueCapacity": 100,
    "JobRetention": "00:30:00",
    "MaxTrackedJobs": 500,
    "WebpQuality": 75,
    "WebpLossless": false,
    "DownscaleFilter": "Box"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4300"
    ]
  }
}
